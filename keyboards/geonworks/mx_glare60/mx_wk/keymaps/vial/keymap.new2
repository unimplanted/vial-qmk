// ↓↓↓ 아래 함수 추가 ↓↓↓
// LED 업데이트 함수
bool led_update_user(led_t led_state) {
    if (led_state.caps_lock) {
        // Caps Lock이 켜질 때 1-8번 LED 각각 설정된 색으로 변경
        // rgblight_setrgb_at(255, 0, 0, 0);     // 1번 LED: 체리식 빨강
           rgblight_setrgb_at(0, 255, 255, 1);     // 2번 LED: 마제식 cyan
        // rgblight_setrgb_at(0, 0, 255, 2);     // 3번 LED: 파랑
        // rgblight_setrgb_at(255, 255, 0, 3);   // 4번 LED: 노랑
        // rgblight_setrgb_at(255, 0, 255, 4);   // 5번 LED: 자주
        // rgblight_setrgb_at(0, 255, 255, 5);   // 6번 LED: 청록
        // rgblight_setrgb_at(255, 165, 0, 6);   // 7번 LED: 오렌지
        // rgblight_setrgb_at(128, 0, 128, 7);   // 8번 LED: 보라
    } else {
        // Caps Lock이 꺼질 때 모든 LED를 끄기
        for (uint8_t i = 0; i < 8; i++) {
            rgblight_setrgb_at(0, 0, 0, i); // 모든 LED 끄기
        }
    }
    return false;
}
